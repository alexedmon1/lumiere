{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexedmon1/neurobox-dev/src/neurobox/schemas/columns.schema.json",
  "title": "neurofaune.results column dictionary (<table>.json)",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["Description"],
    "properties": {
      "Description": {"type": "string", "minLength": 1},
      "Units": {"type": "string"},
      "Levels": {"type": "object", "additionalProperties": {"type": "string"}},
      "Standard": {"enum": ["measure", "contrast", "contrast_label", "facet", "element", "test_kind",
                            "tested_direction", "observed_direction", "group_a", "group_b", "n", "n_a",
                            "n_b", "df", "effect_size", "effect_ci_low", "effect_ci_high",
                            "effect_selected", "estimate", "mean_a", "mean_b", "mean", "stat",
                            "p_value", "significant", "n_significant", "frac_significant", "n_voxels",
                            "volume_mm3", "peak_xyz_mm", "peak_region", "regions", "crosses_midline",
                            "subgroup_effect", "subgroup_n", "se", "mde", "mde_percent", "mde_note",
                            "correction_family", "p_uncorrected", "effect_measure", "margin",
                            "equivalent", "posterior_median", "hdi_low", "hdi_high", "p_direction",
                            "p_rope", "bf10", "sesoi", "reading"]},
      "EffectMeasure": {"type": "string", "minLength": 1},
      "EffectScope": {"type": "string"},
      "CILevel": {"type": "number", "minimum": 0},
      "StatName": {"type": "string", "minLength": 1},
      "StatScope": {"type": "string"},
      "PKind": {"enum": ["fwe", "fdr", "perm", "uncorrected", "none", "per_family"]},
      "PScope": {"type": "string"},
      "Alpha": {"type": "number", "minimum": 0},
      "Power": {"type": "number", "minimum": 0},
      "Space": {"type": "string", "minLength": 1},
      "Subgroup": {"type": "string", "minLength": 1},
      "FacetName": {"type": "string", "minLength": 1},
      "PercentOf": {"type": "string", "minLength": 1},
      "Rope": {"type": "string", "minLength": 1},
      "Scale": {"enum": ["log10", "linear"]},
      "Basis": {"type": "string", "minLength": 1}
    }
  }
}
